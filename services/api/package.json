{
  "name": "@qubedu/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@hono/node-server": "1.19.17",
    "@node-rs/argon2": "2.2.2",
    "@qubedu/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "ioredis": "5.11.1",
    "jose": "6.2.13",
    "nodemailer": "10.2.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.25.12",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}
