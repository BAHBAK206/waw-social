{
  "name": "qubedu",
  "private": true,
  "version": "2.0.0",
  "description": "Qubedu — educational social learning platform (web, mobile, API, realtime, AI).",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --filter=!@qubedu/mobile run build",
    "build:cloudflare": "pnpm --filter @qubedu/web... run build && node infra/cloudflare/prepare.mjs",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --filter=!@qubedu/mobile --filter=!@qubedu/e2e run test",
    "test:e2e": "pnpm --filter @qubedu/e2e run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @qubedu/api run db:migrate",
    "db:seed": "pnpm --filter @qubedu/api run db:seed",
    "local:services": "bash scripts/local-services.sh start",
    "local:stop": "bash scripts/local-services.sh stop",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
