# Copy to .env and edit. Used by docker-compose.yml and (for the API) by `pnpm dev`.
# Generate secrets with:  openssl rand -base64 48

# --- Required in production -------------------------------------------------
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
INTERNAL_TOKEN=change-me-internal-token
POSTGRES_PASSWORD=qubedu
# The first account that registers with this email becomes the root administrator.
ROOT_ADMIN_EMAIL=

# --- Public URLs ------------------------------------------------------------
# Where users open the site, and where the API / realtime hub are reachable from browsers and phones.
APP_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080
REALTIME_PUBLIC_URL=ws://localhost:8080/ws
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080

# --- Storage (minio is bundled; point at S3/R2 to use a cloud bucket) --------
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=qubedu
S3_ACCESS_KEY_ID=qubedu
S3_SECRET_ACCESS_KEY=qubedu-secret-key
# Optional CDN / public bucket URL used for public files.
S3_PUBLIC_URL=

# --- Card payments for paid courses (optional) ------------------------------------
# Without these, paid courses are joined with teacher vouchers only. Webhook endpoint: https://YOUR_DOMAIN/webhooks/stripe
# (events: checkout.session.completed, checkout.session.async_payment_succeeded/failed, checkout.session.expired)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Alerts (optional): Slack / Discord / Telegram webhook for server errors, failed backups, video problems ---
ALERT_WEBHOOK_URL=
# --- CDN in front of public files (optional), e.g. https://cdn.example.com ---
PUBLIC_FILES_URL=

# --- Push notifications (optional) ----------------------------------------------
# Browser notifications are signed with VAPID keys. Leave empty and the API generates a pair once and keeps it
# in the database. To set your own: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Phone notifications go through Expo; the app needs an EAS project id (run `npx eas init` in apps/mobile once).

# --- Email (verification, password reset). Leave SMTP_HOST empty to log emails instead ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Qubedu <no-reply@example.com>
REQUIRE_EMAIL_VERIFICATION=false

# --- AI tutor ---------------------------------------------------------------
# Optional: with a key the tutor can phrase answers with Claude; without it, math (SymPy) and
# course-material retrieval still work.
ANTHROPIC_API_KEY=
AI_DAILY_QUOTA=60

# --- Live classes: TURN relay for users behind strict NATs (optional) ------------
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

TRUST_PROXY=true
LOG_LEVEL=info
