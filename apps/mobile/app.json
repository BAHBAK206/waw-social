{
  "expo": {
    "name": "Qubedu",
    "slug": "qubedu",
    "scheme": "qubedu",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6c5ce7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.qubedu.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take photos for posts and your profile.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to posts and your profile.",
        "NSMicrophoneUsageDescription": "Used to record voice notes and to practise pronunciation.",
        "NSSpeechRecognitionUsageDescription": "Used to score your pronunciation in the pronunciation lab.",
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "package": "app.qubedu.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6c5ce7"
      },
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "RECORD_AUDIO"],
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_PHONE_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#6c5ce7"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Used to hear you in the pronunciation lab.",
          "speechRecognitionPermission": "Used to score your pronunciation in the pronunciation lab.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Used to record voice notes and to practise pronunciation."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6c5ce7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:8787",
      "webUrl": "http://localhost:5173"
    },
    "description": "Qubedu: classes, video lessons, quizzes, flashcards and a study assistant in Arabic, English, French and Spanish.",
    "primaryColor": "#6c5ce7",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json"
    }
  }
}
