{
  "expo": {
    "name": "Qubedu",
    "slug": "qubedu",
    "scheme": "qubedu",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6c5ce7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.qubedu.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take photos for posts and your profile.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to posts and your profile."
      }
    },
    "android": {
      "package": "app.qubedu.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6c5ce7"
      },
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Used to hear you in the pronunciation lab.",
          "speechRecognitionPermission": "Used to score your pronunciation in the pronunciation lab.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6c5ce7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:8787",
      "webUrl": "http://localhost:5173"
    }
  }
}
